# Copy this file to .env and fill in your own values. Never commit or share the real .env.
# MONGO_URI: your MongoDB Atlas connection string. JWT_SECRET: a long random string (at least 32 characters).

RPORT=
MONGO_URI=
JWT_SECRET=
FIRMS_MAP_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
GNEWS_API_KEY=
GNEWS_LANGUAGE=
GNEWS_COUNTRY=
GNEWS_MAX_ARTICLES=
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=

# Long random secret used to sign nearby-network alerts. Set it on the server; without it a new key is made at every start.
MESH_SIGNING_KEY=

# Phone push through Firebase (optional; without it the app keeps its own alert connection open). The Firebase service-account JSON text, or the same text in base64. Never put it in git or in a zip.
FIREBASE_SERVICE_ACCOUNT=

# Optional: Open-Meteo paid key. The free host limits a hosted server's shared address (error 429); the server also keeps the last good answer.
OPEN_METEO_API_KEY=

# Gmail OAuth2 SMTP credentials for OTP email. Keep these only in backend/.env or server secrets.
GMAIL_OAUTH_USER=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Passkeys (sign in with fingerprint, face or screen lock)
# The address passkeys belong to. Set it once and never change it, or every saved passkey stops working. Example: sentry-x.onrender.com
PASSKEY_RP_ID=
PASSKEY_RP_NAME=SENETRY
# SHA-256 fingerprint(s) of the key the phone app is signed with, comma separated (keytool -list -v -keystore <file> shows them).
ANDROID_CERT_SHA256=
ANDROID_PACKAGE=in.senetry.citizen

# SENETRY Test Console. A secret of 12 or more characters lets the console set a demo scene that citizen phones play (a test alert, a red card, and so on).
# Leave it empty to switch the feature off: /api/demo/trigger then answers 404.
DEMO_TEST_KEY=

# In-app update. Set these to announce a newer app: the phone then offers 'Update now' / 'Open without updating'. Leave APP_LATEST_VERSION_CODE empty for no offer.
# The file must be served over https; APP_LATEST_SHA256 is the SHA-256 of that exact file (the phone refuses a file that does not match).
# APP_MIN_VERSION_CODE is optional: older apps are told the update is required (they can still open the app).
APP_LATEST_VERSION_CODE=
APP_LATEST_VERSION_NAME=
APP_LATEST_URL=
APP_LATEST_SHA256=
APP_LATEST_SIZE_BYTES=
APP_LATEST_NOTES=
APP_MIN_VERSION_CODE=
